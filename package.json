{
  "name": "banatier-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run typecheck && npm --prefix frontend run build",
    "db:init": "npm --prefix backend run db:init",
    "test": "npm --prefix backend test"
  }
}
