# Port server Backend API
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

# AWS RDS PostgreSQL connection string (kosongkan di lokal agar memakai embedded PGlite di ./data/banatier-pg)
# Contoh AWS RDS: postgresql://postgres:password@banatier-db.xxxx.ap-southeast-1.rds.amazonaws.com:5432/banatier
DATABASE_URL=""
DATABASE_SSL="false"

# Wajib sama persis di seluruh instance server saat memakai Load Balancer AWS (INF-005)
JWT_SECRET="banatier-change-this-secret-in-aws-production-2026"
SERVER_INSTANCE_ID="backend-node-01"
# Set "true" HANYA jika ALB/domain sudah memakai HTTPS (SSL/ACM); biarkan "false" jika akses via HTTP
USE_HTTPS="false"
# Kredensial privat khusus Admin (hanya diketahui pemilik/admin, tidak ditampilkan ke publik)
ADMIN_EMAIL="owner@banatier.id"
ADMIN_PASSWORD="ganti-dengan-password-admin-rahasia"

# Payment Gateway QRIS ("demo" atau "midtrans")
PAYMENT_MODE="demo"
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
WEBHOOK_SECRET="banatier-webhook-hmac-secret-2026"

# Opsional: Token Fonnte WhatsApp Gateway (https://fonnte.com) untuk kirim invoice WA otomatis ke pembeli
FONNTE_TOKEN=""
